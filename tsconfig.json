{
  "extends": "@plyaz/devtools/configs/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "composite": true,
    "allowJs": true,
    "incremental": true,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components": ["./src/components"],
      "@/public/*": ["./public/assets/*"],
      "@/types": ["./src/types"],
      "@/constants": ["./src/constants"],
      "@/actions": ["./src/app/actions"],
      "@/utils": ["./src/utils"],
      "@/providers": ["./src/providers"],
      "@/icons": ["./src/components/icons"],
      "@/config/*": ["./src/config/*"],
      "@/core/*": ["./src/core/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "./src/**/*",
    "./tests/**/*",
    ".next/types/**/*.ts",
    "*.ts",
    "./messages/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage"
  ]
}
