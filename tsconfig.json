{
  "extends": "@plyaz/devtools/configs/tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler", // To fix the Next.js compatibility
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "allowJs": true,
    "incremental": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["src", ".next/types/**/*.ts"]
}
