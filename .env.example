# =============================================================================
# Plyaz Editor - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!
# =============================================================================

# =============================================================================
# Environment
# =============================================================================
NODE_ENV=development
# NODE_ENV=staging
# NODE_ENV=production

# =============================================================================
# Application (Editor-specific)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave empty for same-origin API calls (Next.js API routes)
# Set to external URL only if using separate API server
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_KEY=your-api-key-here
SERVICE_NAME=plyaz-editor

# =============================================================================
# Database (PostgreSQL via Supabase or direct connection)
# =============================================================================
# Option 1: Direct PostgreSQL connection (recommended for backend services)
# Find in Supabase: Dashboard > Settings > Database > Connection string
# Use "Session mode" for direct connection or "Transaction mode" for pooling
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Option 2: Transaction mode with PgBouncer (recommended for production)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true

# Leave commented to use in-memory dummy data (for testing without real DB)
# DATABASE_URL=

# =============================================================================
# Supabase (Database + Storage)
# =============================================================================
# Find in Supabase: Dashboard > Settings > API

# Project URL
SUPABASE_URL=https://[PROJECT_REF].supabase.co

# Service role key (admin access, bypasses RLS - use server-side only!)
# ⚠️ NEVER expose to frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anonymous/public key (respects RLS policies - safe for frontend)
SUPABASE_ANON_PUBLIC_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage bucket name (defaults to 'media' if not specified)
# SUPABASE_STORAGE_BUCKET=media

# Optional: Public URL for public file access
# SUPABASE_PUBLIC_URL=https://[PROJECT_REF].supabase.co/storage/v1/object/public

# Optional: Webhook secret for storage event notifications
# SUPABASE_WEBHOOK_SECRET=your-strong-random-webhook-secret

# =============================================================================
# Cache (Redis - optional, falls back to memory)
# =============================================================================
# Local: brew install redis (Mac), apt-get install redis (Linux)
# Docker: docker run -d -p 6379:6379 redis
# Cloud: Redis Cloud, AWS ElastiCache, Upstash, etc.
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# =============================================================================
# Encryption (for sensitive data)
# =============================================================================
# Required for: DB field encryption, API encryption, notification tokens
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Optional: Encryption algorithm configuration (defaults are secure)
# Database field-level encryption algorithm
# Options: aes-256-gcm (default, recommended), aes-256-cbc
# DB_ENCRYPTION_ALGORITHM=aes-256-gcm

# API request/response encryption algorithm
# Options: AES-GCM (default), AES-CBC, ChaCha20-Poly1305
# ChaCha20-Poly1305 is faster on mobile/ARM without AES hardware acceleration
# API_ENCRYPTION_ALGORITHM=AES-GCM
# API_ENCRYPTION_KEY_ID=api-key-v1
# API_ENCRYPTION_KEY_FORMAT=raw

# =============================================================================
# Storage - Cloudflare R2 (for compliance documents: invoices, tax, KYC)
# =============================================================================
# Get started: https://dash.cloudflare.com → R2
# Free tier: 10 GB storage, zero egress fees, S3-compatible API
#
# How to get credentials:
# 1. Account ID: R2 dashboard → top right corner
# 2. Access Keys: R2 → Manage R2 API Tokens → Create API Token
#    - Use S3 credentials (Access Key ID + Secret Access Key)
#    - NOT the API Token shown in dashboard
# 3. Bucket: Create in R2 dashboard or use autoCreateBuckets
# 4. Endpoint: Jurisdiction-specific (optional, defaults to auto)

# Required for R2 storage
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional: Bucket configuration
# R2_BUCKET_NAME=plyaz-compliance
# R2_REGION=auto

# Optional: Custom endpoint (defaults to auto jurisdiction)
# Auto: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# EU: https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# US East: https://<ACCOUNT_ID>.enam.r2.cloudflarestorage.com
# US West: https://<ACCOUNT_ID>.wnam.r2.cloudflarestorage.com
# APAC: https://<ACCOUNT_ID>.apac.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Optional: Public domain for public file access (R2 → bucket → Settings → Public Access)
# R2_PUBLIC_DOMAIN=https://pub-xxxxx.r2.dev

# Optional: Webhook secret for R2 event notifications
# R2_WEBHOOK_SECRET=your-strong-random-webhook-secret

# =============================================================================
# Security - Virus Scanning (optional plugins)
# =============================================================================
# VirusTotal (Cloud-based): https://www.virustotal.com/gui/join-us
# Free tier: 500 requests/day, 650MB max file size
# VIRUSTOTAL_API_KEY=

# ClamAV (Self-hosted)
# Install: apt-get install clamav clamav-daemon
# Docker: docker run -d -p 3310:3310 clamav/clamav
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# =============================================================================
# CDN - Cache Invalidation (optional)
# =============================================================================
# Cloudflare CDN
# Find: Dashboard → Domain → Overview → Zone ID (right sidebar)
# API Token: Profile → API Tokens → Create Token (Cache Purge permission)
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# AWS CloudFront
# Distribution ID: CloudFront console → Distributions
# Access Keys: IAM console → Users → Security credentials
# Permissions needed: cloudfront:CreateInvalidation
# CLOUDFRONT_DISTRIBUTION_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Fastly CDN
# Service ID: Dashboard → Select service
# API Token: Account → Personal profile → API tokens → Create token
# FASTLY_SERVICE_ID=
# FASTLY_API_TOKEN=

# =============================================================================
# Notifications - Infobip (primary email & SMS provider)
# =============================================================================
# Get started: https://portal.infobip.com
# Unified omnichannel platform for email, SMS, and push
#
# How to get credentials:
# 1. API Key: Portal → Settings → API Keys → Create API key
# 2. Base URL: Regional endpoint (varies by region)
#    - Example: https://xxxxx.api.infobip.com
# INFOBIP_API_KEY=
# INFOBIP_BASE_URL=https://api.infobip.com

# Optional: Separate sender for Infobip (overrides FROM_EMAIL)
# INFOBIP_FROM_EMAIL=noreply@yourdomain.com

# Optional: Webhook secret for delivery/tracking events
# INFOBIP_WEBHOOK_SECRET=your-infobip-webhook-secret

# =============================================================================
# Notifications - SendGrid (fallback email provider)
# =============================================================================
# Get started: https://sendgrid.com
# Transactional email fallback with generous free tier
#
# How to get API key:
# 1. Dashboard → Settings → API Keys → Create API Key
# 2. Permissions: Full Access or Mail Send only
# SENDGRID_API_KEY=

# Optional: Separate sender for SendGrid (overrides FROM_EMAIL)
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# SENDGRID_FROM_NAME=YourAppName

# Optional: Webhook configuration for delivery tracking
# SENDGRID_WEBHOOK_SECRET=your-webhook-secret
# SENDGRID_WEBHOOK_PUBLIC_KEY=your-public-key-for-ecdsa-verification

# =============================================================================
# Notifications - Email Sender Configuration
# =============================================================================
# Default sender for all email providers (can be overridden per provider)
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Plyaz

# =============================================================================
# Notifications - Token Configuration
# =============================================================================
# Used for CAN-SPAM compliance links (unsubscribe/preference links)
# Separate from ENCRYPTION_KEY for security isolation
# Generate with: node -e "console.log(require('node:crypto').randomBytes(16).toString('hex'))"
# TOKEN_SECRET=your-32-char-token-secret

# Application base URL (used for unsubscribe/preference links)
# APP_URL=http://localhost:3000
# BASE_URL=http://localhost:3000

# =============================================================================
# Testing Configuration (development only)
# =============================================================================
# TEST_EMAIL_TO=test@example.com
# TEST_LOCALE=en

# =============================================================================
# Debug Configuration
# =============================================================================
# Enable comprehensive API debug reports (prints large debug report to console)
# Default: false (disabled to reduce console noise)
# API_DEBUG_REPORT=true

# Enable verbose API logging (extra request/response logging)
# Default: false
# API_VERBOSE=true

# =============================================================================
# Observability - Datadog (optional)
# =============================================================================
# Get started: https://www.datadoghq.com
# APM, metrics, logs, and traces in one platform
# DD_API_KEY=your-datadog-api-key
# DD_SITE=datadoghq.com

# =============================================================================
# API Configuration
# =============================================================================
# API base URL (for external API server, leave empty for Next.js API routes)
# API_BASE_URL=http://localhost:3001
# PORT=3001

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
# ✅ DO:
# - Use different credentials for dev/staging/production
# - Store production secrets in a secrets manager (AWS Secrets Manager, Vault)
# - Add .env to .gitignore (never commit secrets!)
# - Rotate API keys/tokens every 90 days
# - Use service_role keys only on server-side
# - Generate strong webhook secrets (min 32 characters)
# - Use environment-specific buckets (never share prod with dev)
#
# ❌ DON'T:
# - Never commit .env files to git
# - Never expose service_role keys to frontend
# - Never use production credentials in development
# - Never share API keys in public repositories
# - Never reuse the same secrets across environments
#
# =============================================================================
# QUICK START CHECKLIST
# =============================================================================
# For basic testing (no external services):
# ✓ No environment variables needed! Uses in-memory/mock adapters
#
# For Supabase (database + storage):
# ✓ SUPABASE_URL
# ✓ SUPABASE_SERVICE_ROLE_KEY
# ✓ SUPABASE_ANON_PUBLIC_KEY
#
# For Cloudflare R2 (compliance documents):
# ✓ R2_ACCOUNT_ID (or CLOUDFLARE_ACCOUNT_ID)
# ✓ R2_ACCESS_KEY_ID
# ✓ R2_SECRET_ACCESS_KEY
#
# For email notifications:
# ✓ INFOBIP_API_KEY + INFOBIP_BASE_URL (primary)
# OR
# ✓ SENDGRID_API_KEY (fallback)
# ✓ FROM_EMAIL
#
# For SMS notifications:
# ✓ INFOBIP_API_KEY + INFOBIP_BASE_URL
#
# =============================================================================
